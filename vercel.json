{
  "functions": {
    "api/telegram.js": {
      "maxDuration": 10
    },
    "api/quality-download.js": {
      "maxDuration": 10,
      "includeFiles": "content/quality/**"
    },
    "api/quality-assistant.js": {
      "maxDuration": 30,
      "includeFiles": "content/quality/**"
    }
  },
  "rewrites": [
    {
      "source": "/login",
      "destination": "/quality/login/"
    },
    {
      "source": "/app",
      "destination": "/quality/"
    }
  ]
}
