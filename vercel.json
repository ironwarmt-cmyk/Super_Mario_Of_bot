{
  "functions": {
    "api/telegram.js": {
      "maxDuration": 60
    },
    "api/quality-download.js": {
      "maxDuration": 10,
      "includeFiles": "content/quality/**"
    },
    "api/quality-assistant.js": {
      "maxDuration": 30,
      "includeFiles": "content/quality/**"
    },
    "api/quality-support.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/jb-push",
      "destination": "/api/quality-support?jb=push"
    },
    {
      "source": "/api/jb-account",
      "destination": "/api/quality-support?jb=account"
    },
    {
      "source": "/api/jb-push-cron",
      "destination": "/api/quality-support?jb=pushcron"
    },
    {
      "source": "/api/jb-receipt",
      "destination": "/api/quality-support?jb=receipt"
    },
    {
      "source": "/api/jb-billing",
      "destination": "/api/quality-support?jb=billing"
    },
    {
      "source": "/api/jb-assistant",
      "destination": "/api/quality-support?jb=assistant"
    },
    {
      "source": "/api/jb-links",
      "destination": "/api/quality-support?jb=links"
    },
    {
      "source": "/login",
      "destination": "/quality/login/"
    },
    {
      "source": "/app",
      "destination": "/quality/"
    },
    {
      "source": "/api/community",
      "destination": "/api/telegram?channel=community"
    }
  ],
  "crons": [
    {
      "path": "/api/telegram?channel=community&mode=sweep",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/telegram?channel=community&mode=daily",
      "schedule": "40 6 * * *"
    },
    {
      "path": "/api/jb-push-cron",
      "schedule": "30 6 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/telegram",
      "destination": "https://t.me/Super_Mario_Official_bot",
      "permanent": false
    },
    {
      "source": "/grupa",
      "destination": "https://t.me/MT_Social_Control_bot",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/quality/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/quality/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
