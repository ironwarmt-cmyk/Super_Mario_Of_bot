{
  "functions": {
    "api/telegram.js": {
      "maxDuration": 60
    },
    "api/quality-download.js": {
      "maxDuration": 10,
      "includeFiles": "content/quality/**"
    },
    "api/quality-assistant.js": {
      "maxDuration": 30,
      "includeFiles": "content/quality/**"
    }
  },
  "rewrites": [
    {
      "source": "/login",
      "destination": "/quality/login/"
    },
    {
      "source": "/app",
      "destination": "/quality/"
    },
    {
      "source": "/api/community",
      "destination": "/api/telegram?channel=community"
    },
    {
      "source": "/instagram/latest.json",
      "destination": "https://ixivedtgqgryawxsxnqd.supabase.co/storage/v1/object/public/ig/latest.json"
    },
    {
      "source": "/instagram/:date/manifest.json",
      "destination": "https://ixivedtgqgryawxsxnqd.supabase.co/storage/v1/object/public/ig/daily/:date/manifest.json"
    }
  ],
  "crons": [
    {
      "path": "/api/telegram?channel=community&mode=sweep",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/telegram?channel=community&mode=daily",
      "schedule": "40 6 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/telegram",
      "destination": "https://t.me/Super_Mario_Official_bot",
      "permanent": false
    },
    {
      "source": "/grupa",
      "destination": "https://t.me/MT_Social_Control_bot",
      "permanent": false
    }
  ]
}
